<Project Sdk="Dalamud.NET.Sdk/13.0.0">
    <PropertyGroup>
        <PackageProjectUrl>https://github.com/ffxiv-tc-port/Mappy</PackageProjectUrl>
        <Version>3.1.6.12</Version>
    </PropertyGroup>
    <ItemGroup>
      <None Include=".editorconfig" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\KamiLib\KamiLib.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- KamiLib 的 NetStone 會把 Newtonsoft.Json 帶進輸出目錄；只取編譯期參考，執行期用 Dalamud 那份（版本 13.0.3 相同）。 -->
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" ExcludeAssets="runtime" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="SharpDX" Private="false" />
        <Reference Include="SharpDX.Direct3D11" Private="false" />
        <Reference Include="SharpDX.DXGI" Private="false" />
    </ItemGroup>
</Project>
